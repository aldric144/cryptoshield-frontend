# CryptoShield Guardian AI - Local Development Environment Variables
# Copy this file to .env.local and fill in your local values

# Backend API URL (local development)
VITE_API_URL=http://localhost:8000

# Stripe Public Key (test mode for local development)
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_LOCAL_TEST_KEY

# Environment identifier
VITE_ENV=development

# Service Worker (disabled for local development)
VITE_ENABLE_SW=false

# Feature Flags
VITE_ENABLE_VOICE_ANALYSIS=true
VITE_ENABLE_WALLET_TRACING=true
VITE_ENABLE_GPS_TRACKING=true
VITE_ENABLE_FAMILY_CENTER=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_EMERGENCY=true
