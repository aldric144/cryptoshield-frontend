# CryptoShield Guardian AI - Production Environment Variables
# This file contains environment variables for the PRODUCTION deployment

# Backend API URL (production)
VITE_API_URL=https://api.cryptoshield.app

# Stripe Public Key (production/live mode)
VITE_STRIPE_PUBLIC_KEY=pk_live_REPLACE_WITH_PRODUCTION_KEY

# Environment identifier
VITE_ENV=production

# Service Worker (enabled for production with PWA support)
VITE_ENABLE_SW=true

# Feature Flags
VITE_ENABLE_VOICE_ANALYSIS=true
VITE_ENABLE_WALLET_TRACING=true
VITE_ENABLE_GPS_TRACKING=true
VITE_ENABLE_FAMILY_CENTER=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_EMERGENCY=true
