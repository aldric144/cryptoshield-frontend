# CryptoShield Guardian AI - Staging Environment Variables
# This file contains environment variables for the STAGING deployment

# Backend API URL (staging)
VITE_API_URL=https://staging-api.cryptoshield.app

# Stripe Public Key (staging/test mode)
VITE_STRIPE_PUBLIC_KEY=pk_test_REPLACE_WITH_STAGING_KEY

# Environment identifier
VITE_ENV=staging

# Service Worker (disabled for staging to prevent cache issues during QA)
VITE_ENABLE_SW=false

# Feature Flags
VITE_ENABLE_VOICE_ANALYSIS=true
VITE_ENABLE_WALLET_TRACING=true
VITE_ENABLE_GPS_TRACKING=true
VITE_ENABLE_FAMILY_CENTER=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_EMERGENCY=true
